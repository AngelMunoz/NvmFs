<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- AOT gate: FSharp.Core and friends report IL2104/IL3053 that cannot be
         fixed on our side; user-code warnings (e.g. IL2026/IL3050) still fail. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nvmfs</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="IO.fs" />
    <Compile Include="Network.fs" />
    <Compile Include="Env.fs" />
    <Compile Include="Cmd.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="FSharp.SystemCommandLine" Version="2.3.0" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="JDeck" Version="1.1.0" />
  </ItemGroup>

</Project>
